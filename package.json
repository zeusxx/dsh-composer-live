{
  "name": "dsh-composer-live",
  "version": "0.2.11",
  "description": "DSH Web 0.1.5+ 输入框增强（Lexical contenteditable 架构版）：markdown 实时渲染 + 代码块语法高亮/段落级等宽 + 格式工具栏（常驻顶条 + 选区浮动条）+ 70vh 展开 + 大段粘贴包代码块 + Esc 分发。纯浏览器端插件，零依赖，不改官方源码。仿 Open WebUI 输入体验。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --check client.js && echo OK",
    "test": "node test-live.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "markdown",
    "composer",
    "input",
    "preview",
    "lexical",
    "syntax-highlighting",
    "open-webui"
  ],
  "author": "zeusxx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeusxx/dsh-composer-live.git"
  },
  "bugs": {
    "url": "https://github.com/zeusxx/dsh-composer-live/issues"
  },
  "homepage": "https://github.com/zeusxx/dsh-composer-live#readme"
}
