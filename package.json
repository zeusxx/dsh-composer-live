{
  "name": "dsh-composer-live",
  "version": "0.2.21",
  "description": "Type Markdown, see it rendered live — Open-WebUI-style composer for DeepSeek Harness (DSH) web. Syntax-highlighted code blocks, task lists, format toolbars, smart paste. Pure browser-side, zero dependencies.",
  "icon": "./assets/icon-180.png",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs",
    "assets",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --check client.js && echo OK",
    "test": "node test-live.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "markdown",
    "composer",
    "input",
    "live-preview",
    "preview",
    "toolbar",
    "format",
    "paste",
    "lexical",
    "syntax-highlighting",
    "open-webui"
  ],
  "author": "zeusxx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeusxx/dsh-composer-live.git"
  },
  "bugs": {
    "url": "https://github.com/zeusxx/dsh-composer-live/issues"
  },
  "homepage": "https://github.com/zeusxx/dsh-composer-live#readme"
}
